# Beta container for hello-world-desktop-2's web frontend.
#
# Interim configuration per docs/release-strategy.md's "Container fallback
# on the Development VM": this project doesn't have a provisioned Beta VM
# yet, so this builds the same Vite production bundle a real Beta VM deploy
# would build, and serves it as a static site. Listens on 8080 internally,
# matching the convention beta-vm/deploy/deploy.sh uses, so this Dockerfile
# can be reused as-is once a real Beta VM exists — only the run target
# changes, not the image.

FROM node:22-bookworm AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
RUN sed -i 's/listen  *80;/listen 8080;/' /etc/nginx/conf.d/default.conf
EXPOSE 8080
